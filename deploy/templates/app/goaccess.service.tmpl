# Meshify-managed: app.name={{ .AppName }}
# Source: deploy/templates/app/goaccess.service.tmpl

[Unit]
Description={{ .AppName }} GoAccess real-time access log dashboard
Wants=network-online.target nginx.service
After=network-online.target nginx.service

[Service]
Type=simple
User={{ .GoAccess.SystemUser }}
Group={{ .GoAccess.SystemGroup }}
Environment=LANG={{ .GoAccess.Lang }}
Environment=LC_MESSAGES={{ .GoAccess.LCMessages }}
Environment=LC_CTYPE={{ .GoAccess.LCCType }}
Environment=LC_TIME={{ .GoAccess.LCTime }}
ExecStart={{ .GoAccess.BinaryPath }} --no-global-config --config-file {{ .GoAccess.ConfigPath }}
UMask=0027
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ .GoAccess.ReportPath }} {{ .GoAccess.DBPath }}

[Install]
WantedBy=multi-user.target
