# Meshify-managed: app.name={{ .AppName }}
# Source: deploy/templates/app/lego-renew.service.tmpl

[Unit]
Description=Renew {{ .AppName }} TLS certificate with lego
Documentation=https://go-acme.github.io/lego/usage/cli/renew-a-certificate/
Wants=network-online.target
Requires=nginx.service
After=network-online.target nginx.service

[Service]
Type=oneshot
{{- if and (eq .ACMEChallenge "dns-01") .DNSEnvFile }}
EnvironmentFile={{ .DNSEnvFile }}
{{- end }}
ExecStart=/opt/meshify/bin/lego --path {{ .LegoDataPath }} --email {{ .CertificateEmail }}{{ range .Domains }} --domains {{ . }}{{ end }}{{ if eq .ACMEChallenge "dns-01" }} --dns {{ .DNSProvider }}{{ else }} --http --http.webroot {{ .WebrootPath }}{{ end }} renew --renew-hook {{ .HookPath }}
