# Meshify-managed: app.name={{ .AppName }}
# Source: deploy/templates/app/service.tmpl

[Unit]
Description={{ .AppName }} application service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ .SystemUser }}
Group={{ .SystemGroup }}
{{- if .WorkingDirectory }}
WorkingDirectory={{ .WorkingDirectory }}
{{- end }}
{{- if .ServiceEnvFile }}
EnvironmentFile={{ .ServiceEnvFile }}
{{- end }}
ExecStart={{ .ExecStart }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
