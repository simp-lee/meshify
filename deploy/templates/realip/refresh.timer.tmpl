# Lanpanel-managed: realip.profile={{ .ProfileName }} provider={{ .Provider }}
# Source: deploy/templates/realip/refresh.timer.tmpl

[Unit]
Description=Run Lanpanel realip profile {{ .ProfileName }} refresh

[Timer]
OnBootSec=15m
OnUnitActiveSec={{ .RefreshInterval }}
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
